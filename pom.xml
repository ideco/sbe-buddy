<?xml version="1.0" encoding="UTF-8"?>
<project root="true" xmlns="http://maven.apache.org/POM/4.1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.1.0 https://maven.apache.org/xsd/maven-4.1.0.xsd">
  <modelVersion>4.1.0</modelVersion>

  <groupId>net.concini</groupId>
  <artifactId>sbe-buddy-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <subprojects>
    <subproject>sbe-buddy-api</subproject>
    <subproject>sbe-buddy-processor</subproject>
    <subproject>sbe-buddy-example</subproject>
  </subprojects>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>21</maven.compiler.release>
    <jspecify.version>1.0.1</jspecify.version>
    <maven-compiler-plugin.version>3.16.0</maven-compiler-plugin.version>
    <maven-jar-plugin.version>3.5.1</maven-jar-plugin.version>
  </properties>

  <!-- Every package is @NullMarked. Optional, so users do not inherit JSpecify. -->
  <dependencies>
    <dependency>
      <groupId>org.jspecify</groupId>
      <artifactId>jspecify</artifactId>
      <version>${jspecify.version}</version>
      <optional>true</optional>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>${maven-compiler-plugin.version}</version>
      </plugin>
      <plugin>
        <artifactId>maven-jar-plugin</artifactId>
        <version>${maven-jar-plugin.version}</version>
        <configuration>
          <archive>
            <manifestEntries>
              <Automatic-Module-Name>${module.name}</Automatic-Module-Name>
            </manifestEntries>
          </archive>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
