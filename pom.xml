<?xml version="1.0" encoding="UTF-8"?>
<project root="true" child.project.url.inherit.append.path="false" xmlns="http://maven.apache.org/POM/4.1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.1.0 https://maven.apache.org/xsd/maven-4.1.0.xsd">
  <modelVersion>4.1.0</modelVersion>

  <groupId>net.concini</groupId>
  <artifactId>sbe-buddy-parent</artifactId>
  <version>0.2.0</version>
  <packaging>pom</packaging>

  <name>sbe-buddy</name>
  <description>Code-first SBE for Java: annotated records become an SBE XML schema, sbe-tool's flyweights and a record codec.</description>
  <url>https://github.com/ideco/sbe-buddy</url>
  <inceptionYear>2026</inceptionYear>

  <licenses>
    <license>
      <name>MIT License</name>
      <url>https://opensource.org/license/mit</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <developers>
    <developer>
      <id>ideco</id>
      <name>Ivo de Concini</name>
      <url>https://github.com/ideco</url>
    </developer>
  </developers>

  <scm child.scm.connection.inherit.append.path="false" child.scm.developerConnection.inherit.append.path="false" child.scm.url.inherit.append.path="false">
    <connection>scm:git:https://github.com/ideco/sbe-buddy.git</connection>
    <developerConnection>scm:git:git@github.com:ideco/sbe-buddy.git</developerConnection>
    <url>https://github.com/ideco/sbe-buddy</url>
    <tag>HEAD</tag>
  </scm>

  <issueManagement>
    <system>GitHub</system>
    <url>https://github.com/ideco/sbe-buddy/issues</url>
  </issueManagement>

  <subprojects>
    <subproject>sbe-buddy-generator</subproject>
    <subproject>sbe-buddy-api</subproject>
    <subproject>sbe-buddy-processor</subproject>
    <subproject>sbe-buddy-example</subproject>
    <subproject>sbe-buddy-tests</subproject>
  </subprojects>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>21</maven.compiler.release>
    <jspecify.version>1.0.1</jspecify.version>
    <sbe-tool.version>1.40.2</sbe-tool.version>
    <agrona.version>2.6.1</agrona.version>
    <junit.version>6.1.3</junit.version>
    <assertj.version>3.27.7</assertj.version>
    <error-prone.version>2.50.0</error-prone.version>
    <nullaway.version>0.14.1</nullaway.version>
    <maven-compiler-plugin.version>3.16.0</maven-compiler-plugin.version>
    <maven-clean-plugin.version>3.4.0</maven-clean-plugin.version>
    <maven-install-plugin.version>3.2.0</maven-install-plugin.version>
    <maven-deploy-plugin.version>3.2.0</maven-deploy-plugin.version>
    <maven-source-plugin.version>3.4.0</maven-source-plugin.version>
    <maven-javadoc-plugin.version>3.12.0</maven-javadoc-plugin.version>
    <maven-resources-plugin.version>3.5.0</maven-resources-plugin.version>
    <maven-surefire-plugin.version>3.6.0</maven-surefire-plugin.version>
    <maven-jar-plugin.version>3.5.1</maven-jar-plugin.version>
    <spotless-maven-plugin.version>3.10.2</spotless-maven-plugin.version>
    <exec-maven-plugin.version>3.6.4</exec-maven-plugin.version>
    <build-helper-maven-plugin.version>3.6.2</build-helper-maven-plugin.version>
  </properties>

  <!-- The BOM keeps the engine and the launcher on one version. Surefire aligns
       the launcher it runs to the platform it finds, so declaring the launcher
       makes that agreement ours to state rather than surefire's to infer. -->
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${junit.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <!-- Every package is @NullMarked. Optional, so users do not inherit JSpecify. -->
  <dependencies>
    <dependency>
      <groupId>org.jspecify</groupId>
      <artifactId>jspecify</artifactId>
      <version>${jspecify.version}</version>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.platform</groupId>
      <artifactId>junit-platform-launcher</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <version>${assertj.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <!-- The default lifecycle binds these; Maven warns about every version it
         has to choose itself. -->
    <pluginManagement>
      <plugins>
        <plugin>
          <artifactId>maven-clean-plugin</artifactId>
          <version>${maven-clean-plugin.version}</version>
        </plugin>
        <plugin>
          <artifactId>maven-resources-plugin</artifactId>
          <version>${maven-resources-plugin.version}</version>
        </plugin>
        <plugin>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${maven-surefire-plugin.version}</version>
          <!-- Agrona's buffers call jdk.internal.misc.Unsafe; a test JVM that
               loads one needs this, a user's javac never does. -->
          <configuration>
            <argLine>--add-opens java.base/jdk.internal.misc=ALL-UNNAMED</argLine>
          </configuration>
        </plugin>
        <plugin>
          <artifactId>maven-install-plugin</artifactId>
          <version>${maven-install-plugin.version}</version>
        </plugin>
        <plugin>
          <artifactId>maven-deploy-plugin</artifactId>
          <version>${maven-deploy-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>exec-maven-plugin</artifactId>
          <version>${exec-maven-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>build-helper-maven-plugin</artifactId>
          <version>${build-helper-maven-plugin.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>

    <plugins>
      <!-- The deployed POMs are flattened (.mvn/maven.config), so none names
           this one as its parent and it is not deployed itself. -->
      <plugin>
        <artifactId>maven-deploy-plugin</artifactId>
        <inherited>false</inherited>
        <configuration>
          <skip>true</skip>
        </configuration>
      </plugin>
      <plugin>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>${maven-compiler-plugin.version}</version>
        <configuration>
          <!-- Error Prone carries NullAway and nothing else; the exports it
               needs are in .mvn/jvm.config. -->
          <compilerArgs>
            <arg>-XDcompilePolicy=simple</arg>
            <arg>-XDshould-stop.ifError=FLOW</arg>
            <arg>-XDaddTypeAnnotationsToSymbol=true</arg>
            <arg>-Xplugin:ErrorProne -XepDisableAllChecks -Xep:NullAway:ERROR -XepOpt:NullAway:OnlyNullMarked=true -XepOpt:NullAway:JSpecifyMode=true -XepExcludedPaths:.*/(generated-sources|src/test)/.*</arg>
          </compilerArgs>
          <annotationProcessorPaths>
            <path>
              <groupId>com.google.errorprone</groupId>
              <artifactId>error_prone_core</artifactId>
              <version>${error-prone.version}</version>
            </path>
            <path>
              <groupId>com.uber.nullaway</groupId>
              <artifactId>nullaway</artifactId>
              <version>${nullaway.version}</version>
            </path>
          </annotationProcessorPaths>
        </configuration>
      </plugin>
      <plugin>
        <artifactId>maven-jar-plugin</artifactId>
        <version>${maven-jar-plugin.version}</version>
        <configuration>
          <archive>
            <manifestEntries>
              <Automatic-Module-Name>${module.name}</Automatic-Module-Name>
            </manifestEntries>
          </archive>
        </configuration>
      </plugin>
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>${spotless-maven-plugin.version}</version>
        <configuration>
          <java>
            <removeUnusedImports/>
            <importOrder>
              <order>\#,java,javax,org,uk,net</order>
            </importOrder>
            <eclipse>
              <file>${session.rootDirectory}/config/eclipse-formatter.properties</file>
            </eclipse>
          </java>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <!-- A release: the sources and javadoc jars Central requires beside every
       jar, and a deploy into a directory rather than to a server, so that what
       is signed and uploaded is what Maven wrote, consumer POMs included.
       .github/workflows/release.yml runs it and hands the directory to
       .github/central-publish.sh. -->
  <profiles>
    <profile>
      <id>release</id>
      <properties>
        <altDeploymentRepository>staging::file:${session.rootDirectory}/target/staging</altDeploymentRepository>
      </properties>
      <build>
        <plugins>
          <plugin>
            <artifactId>maven-source-plugin</artifactId>
            <version>${maven-source-plugin.version}</version>
            <executions>
              <execution>
                <goals>
                  <goal>jar-no-fork</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <artifactId>maven-javadoc-plugin</artifactId>
            <version>${maven-javadoc-plugin.version}</version>
            <!-- The API is documented in prose, not in @param and @return. -->
            <configuration>
              <doclint>all,-missing</doclint>
            </configuration>
            <executions>
              <execution>
                <goals>
                  <goal>jar</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
