<?xml version="1.0" encoding="UTF-8"?>
<!-- Version 8 of com.example.quotes, frozen: never edited again. The
     reference flyweights in com.example.quotes.xmlref.v8 come from it. -->
<sbe:messageSchema xmlns:sbe="http://fixprotocol.io/2016/sbe"
                   package="com.example.quotes"
                   id="92"
                   version="8"
                   description="Top of book quotes">
    <types>
        <composite name="messageHeader">
            <type name="blockLength" primitiveType="uint16"/>
            <type name="templateId" primitiveType="uint16"/>
            <type name="schemaId" primitiveType="uint16"/>
            <type name="version" primitiveType="uint16"/>
        </composite>
        <enum name="Venue" encodingType="uint8" description="Where a quote comes from">
            <validValue name="XNAS">1</validValue>
            <validValue name="XNYS">2</validValue>
            <validValue name="XLON">3</validValue>
        </enum>
        <enum name="MarketState" encodingType="char" description="The state of the instrument's market">
            <validValue name="OPEN">O</validValue>
            <validValue name="HALTED">H</validValue>
            <validValue name="CLOSED">C</validValue>
        </enum>
        <set name="QuoteFlag" encodingType="uint8" description="What a quote says about itself">
            <choice name="indicative">0</choice>
            <choice name="crossed">1</choice>
            <choice name="locked">2</choice>
        </set>
        <type name="Symbol" primitiveType="char" length="8" characterEncoding="US-ASCII" semanticType="String" description="An instrument symbol, NUL padded"/>
        <type name="PriceExponent" primitiveType="int8" presence="constant" description="The power of ten every price is scaled by">-4</type>
        <type name="Depth" primitiveType="uint32" length="5" description="The sizes at the five best levels, best first"/>
        <composite name="Trade" description="A trade as its price and its size">
            <type name="price" primitiveType="int64"/>
            <type name="size" primitiveType="uint32"/>
        </composite>
        <composite name="groupSizeEncoding">
            <type name="blockLength" primitiveType="uint16"/>
            <type name="numInGroup" primitiveType="uint16"/>
        </composite>
        <composite name="varStringEncoding">
            <type name="length" primitiveType="uint16"/>
            <type name="varData" primitiveType="char" length="0" characterEncoding="UTF-8"/>
        </composite>
    </types>
    <sbe:message name="Quote" id="1" description="The best bid and offer of one instrument">
        <field name="instrumentId" id="1" type="int64"/>
        <field name="bid" id="2" type="int64"/>
        <field name="ask" id="3" type="int64"/>
        <field name="bidSize" id="4" type="uint32"/>
        <field name="askSize" id="5" type="uint32"/>
        <field name="sequence" id="6" type="uint64" sinceVersion="1" description="The sequence number of the update"/>
        <field name="tradeCount" id="7" type="uint32" sinceVersion="2" deprecated="4" description="Trades of the session so far"/>
        <field name="vwap" id="8" type="double" presence="optional" sinceVersion="2" description="The volume-weighted average price of the session, absent until the instrument has traded"/>
        <field name="venue" id="9" type="Venue" sinceVersion="3" description="The venue the quote comes from"/>
        <field name="state" id="10" type="MarketState" sinceVersion="3" description="The state of the instrument's market"/>
        <field name="flags" id="11" type="QuoteFlag" sinceVersion="3" description="What the quote says about itself"/>
        <field name="symbol" id="12" type="Symbol" sinceVersion="5" description="The instrument's symbol"/>
        <field name="priceExponent" id="13" type="PriceExponent" sinceVersion="5" description="The exponent of bid, ask and vwap"/>
        <field name="bidDepth" id="14" type="Depth" sinceVersion="5" description="The bid sizes at the five best levels"/>
        <field name="lastTrade" id="15" type="Trade" sinceVersion="6" description="The last trade of the instrument"/>
        <group name="contributors" id="16" sinceVersion="7" description="The venues' own quotes behind the best">
            <field name="venue" id="17" type="Venue" description="The venue quoting"/>
            <field name="bid" id="18" type="int64"/>
            <field name="ask" id="19" type="int64"/>
            <field name="bidSize" id="20" type="uint32"/>
            <field name="askSize" id="21" type="uint32"/>
        </group>
        <data name="remark" id="22" type="varStringEncoding" sinceVersion="8" description="The quoting desk's own words on the quote"/>
    </sbe:message>
</sbe:messageSchema>
