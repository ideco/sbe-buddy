<?xml version="1.0" encoding="UTF-8"?>
<!-- The oracle for com.example.trading: the schema the annotated records must
     produce, written by hand as a person would write it. SbeTool reads it from
     here. -->
<sbe:messageSchema xmlns:sbe="http://fixprotocol.io/2016/sbe"
                   package="com.example.trading"
                   id="91"
                   version="0"
                   semanticVersion="FIX.5.0SP2"
                   description="A small trading schema">
    <types>
        <composite name="messageHeader">
            <type name="blockLength" primitiveType="uint16"/>
            <type name="templateId" primitiveType="uint16"/>
            <type name="schemaId" primitiveType="uint16"/>
            <type name="version" primitiveType="uint16"/>
        </composite>
        <composite name="groupSizeEncoding">
            <type name="blockLength" primitiveType="uint16"/>
            <type name="numInGroup" primitiveType="uint16"/>
        </composite>
        <composite name="varStringEncoding">
            <type name="length" primitiveType="uint16"/>
            <type name="varData" primitiveType="char" length="0" characterEncoding="UTF-8"/>
        </composite>
        <type name="Symbol" primitiveType="char" length="8" characterEncoding="US-ASCII" semanticType="String"/>
        <composite name="Price" semanticType="Price" description="A decimal price as mantissa and exponent">
            <type name="mantissa" primitiveType="int64"/>
            <type name="exponent" primitiveType="int8"/>
        </composite>
        <enum name="Side" encodingType="char">
            <validValue name="BUY">B</validValue>
            <validValue name="SELL">S</validValue>
        </enum>
    </types>
    <sbe:message name="NewOrder" id="1" semanticType="D" description="A new single order">
        <field name="orderId" id="1" type="int64"/>
        <field name="symbol" id="2" type="Symbol"/>
        <field name="side" id="3" type="Side"/>
        <field name="price" id="4" type="Price"/>
        <field name="quantity" id="5" type="uint32"/>
        <group name="legs" id="6" description="The legs of a multi-leg order">
            <field name="instrumentId" id="1" type="int64"/>
            <field name="ratio" id="2" type="int32"/>
        </group>
        <data name="note" id="7" type="varStringEncoding"/>
    </sbe:message>
    <sbe:message name="CancelOrder" id="2" semanticType="F" description="Cancel an order already sent">
        <field name="orderId" id="1" type="int64"/>
        <field name="symbol" id="2" type="Symbol"/>
    </sbe:message>
</sbe:messageSchema>
