<?xml version="1.0" encoding="UTF-8"?>
<!-- Version 2 of com.example.quotes, frozen: never edited again. The
     reference flyweights in com.example.quotes.xmlref.v2 come from it. -->
<sbe:messageSchema xmlns:sbe="http://fixprotocol.io/2016/sbe"
                   package="com.example.quotes"
                   id="92"
                   version="2"
                   description="Top of book quotes">
    <types>
        <composite name="messageHeader">
            <type name="blockLength" primitiveType="uint16"/>
            <type name="templateId" primitiveType="uint16"/>
            <type name="schemaId" primitiveType="uint16"/>
            <type name="version" primitiveType="uint16"/>
        </composite>
    </types>
    <sbe:message name="Quote" id="1" description="The best bid and offer of one instrument">
        <field name="instrumentId" id="1" type="int64"/>
        <field name="bid" id="2" type="int64"/>
        <field name="ask" id="3" type="int64"/>
        <field name="bidSize" id="4" type="uint32"/>
        <field name="askSize" id="5" type="uint32"/>
        <field name="sequence" id="6" type="uint64" sinceVersion="1" description="The sequence number of the update"/>
        <field name="tradeCount" id="7" type="uint32" sinceVersion="2" description="Trades of the session so far"/>
        <field name="vwap" id="8" type="double" presence="optional" sinceVersion="2" description="The volume-weighted average price of the session, absent until the instrument has traded"/>
    </sbe:message>
</sbe:messageSchema>
