<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.1.0 https://maven.apache.org/xsd/maven-4.1.0.xsd">
  <modelVersion>4.1.0</modelVersion>

  <parent>
    <groupId>net.concini</groupId>
    <artifactId>sbe-buddy-parent</artifactId>
  </parent>

  <artifactId>sbe-buddy-benchmarks</artifactId>
  <name>sbe-buddy benchmarks</name>
  <description>JMH benchmarks of the example's codecs; not deployed.</description>

  <!-- The example's codecs, and its samples from its test jar. Built with the
       rest, run by hand:
       ./mvnw -pl sbe-buddy-benchmarks -am package && java -jar sbe-buddy-benchmarks/target/benchmarks.jar -->
  <dependencies>
    <dependency>
      <groupId>net.concini</groupId>
      <artifactId>sbe-buddy-example</artifactId>
    </dependency>
    <dependency>
      <groupId>net.concini</groupId>
      <artifactId>sbe-buddy-example</artifactId>
      <type>test-jar</type>
    </dependency>
    <dependency>
      <groupId>org.openjdk.jmh</groupId>
      <artifactId>jmh-core</artifactId>
      <version>${jmh.version}</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <!-- Appended to the parent's Error Prone and NullAway paths. -->
          <annotationProcessorPaths combine.children="append">
            <path>
              <groupId>org.openjdk.jmh</groupId>
              <artifactId>jmh-generator-annprocess</artifactId>
              <version>${jmh.version}</version>
            </path>
          </annotationProcessorPaths>
        </configuration>
      </plugin>
      <!-- One runnable jar, JMH's main and its benchmark list included. -->
      <plugin>
        <artifactId>maven-shade-plugin</artifactId>
        <version>${maven-shade-plugin.version}</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <finalName>benchmarks</finalName>
              <!-- Never deployed, so no reduced pom beside the sources. -->
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>org.openjdk.jmh.Main</mainClass>
                </transformer>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
              </transformers>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>module-info.class</exclude>
                    <exclude>META-INF/MANIFEST.MF</exclude>
                    <exclude>META-INF/maven/**</exclude>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <properties>
    <!-- Measurement, not product: never deployed. -->
    <maven.deploy.skip>true</maven.deploy.skip>
    <module.name>net.concini.sbebuddy.benchmarks</module.name>
  </properties>
</project>
