<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.1.0 https://maven.apache.org/xsd/maven-4.1.0.xsd">
  <modelVersion>4.1.0</modelVersion>

  <parent>
    <groupId>net.concini</groupId>
    <artifactId>sbe-buddy-parent</artifactId>
  </parent>

  <artifactId>sbe-buddy-api</artifactId>
  <name>sbe-buddy API</name>
  <description>The annotations a schema is written in, the Codec contract and TypeBinding: all a user compiles against.</description>

  <!-- The flyweights sbe-tool generates compile against Agrona, and the api is
       all a user depends on. -->
  <dependencies>
    <dependency>
      <groupId>org.agrona</groupId>
      <artifactId>agrona</artifactId>
      <version>${agrona.version}</version>
    </dependency>
  </dependencies>

  <properties>
    <module.name>net.concini.sbebuddy</module.name>
  </properties>
</project>
